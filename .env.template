# ═══════════════════════════════════════════════════
#  Emo Robot — Backend Configuration
#  Copy this file to .env and fill in your values.
#  DO NOT commit .env — it's in .gitignore
# ═══════════════════════════════════════════════════


# ── API Keys ─────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here


# ── LLM Settings ─────────────────────────────────────
# Provider options: groq | gemini
LLM_PROVIDER=groq

# Groq model (default): openai/gpt-oss-20b
# Alternatives: llama-3.1-8b-instant | llama-3.3-70b-versatile
LLM_MODEL=openai/gpt-oss-20b

# Max tokens in LLM response (keep short for robot — 2-3 sentences)
LLM_MAX_TOKENS=120


# ── STT Settings ─────────────────────────────────────
STT_PROVIDER=groq

# Groq STT model options: whisper-large-v3-turbo | whisper-large-v3
STT_MODEL=whisper-large-v3-turbo


# ── TTS Settings ─────────────────────────────────────
# Provider: edge_tts (free, no API key needed)
TTS_PROVIDER=edge_tts

# Edge TTS voice (run `edge-tts --list-voices` to see all)
#   en-US-AnaNeural   (female, default)
#   en-US-GuyNeural   (male, natural)
#   en-GB-RyanNeural  (male, British)
TTS_VOICE=en-US-AnaNeural


# ── Memory Settings ──────────────────────────────────
# Last N conversation turns kept as context
SLIDING_WINDOW_SIZE=5

# Keep conversation history across ESP32 reconnects?
MEMORY_PERSIST_ACROSS_SESSIONS=true


# ── Behavior Settings ────────────────────────────────
# Seconds of silence before conversation session resets
ATTENTION_TIMEOUT_SECONDS=20


# ── Server Settings ──────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001


# ── Debug ────────────────────────────────────────────
LOG_LEVEL=INFO       # DEBUG | INFO | WARNING | ERROR
