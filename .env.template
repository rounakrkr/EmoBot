# ═══════════════════════════════════════════════════
#  Emo Robot — Backend Configuration
#  Copy this file to .env and fill in your values.
#  DO NOT commit .env — it's in .gitignore
# ═══════════════════════════════════════════════════


# ── API Keys ─────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here


# ── LLM Settings ─────────────────────────────────────
# Provider options: groq | gemini
LLM_PROVIDER=groq

# Groq model options: llama-3.1-8b-instant | llama-3.3-70b-versatile | mixtral-8x7b-32768
LLM_MODEL=llama-3.1-8b-instant

# Max tokens in LLM response (keep short for robot — 2-3 sentences)
LLM_MAX_TOKENS=120


# ── STT Settings ─────────────────────────────────────
# Provider options: groq
STT_PROVIDER=groq

# Groq STT model options: whisper-large-v3-turbo | whisper-large-v3
STT_MODEL=whisper-large-v3-turbo


# ── TTS Settings ─────────────────────────────────────
# Provider: edge_tts (free, no API key needed)
TTS_PROVIDER=edge_tts

# Edge TTS voice options (run `edge-tts --list-voices` to see all)
# Good robot voices:
#   en-US-GuyNeural        (male, natural)
#   en-US-AriaNeural       (female, natural)
#   en-GB-RyanNeural       (male, British)
#   en-AU-NatashaNeural    (female, Australian)
TTS_VOICE=en-US-GuyNeural

# TTS audio format sent to ESP32
TTS_FORMAT=mp3


# ── Memory Settings ──────────────────────────────────
# Short-term: last N conversation turns always included in context
MEMORY_SHORT_TERM_WINDOW=5

# Long-term: how many semantic memories to retrieve per query
MEMORY_LONG_TERM_RETRIEVE_COUNT=3

# Minimum importance score (0.0-1.0) for a turn to be stored in long-term memory
# Higher = only truly important things remembered
# Lower = more things stored
MEMORY_IMPORTANCE_THRESHOLD=0.65


# ── Behavior Settings ────────────────────────────────
# Seconds of silence before conversation session resets
ATTENTION_TIMEOUT_SECONDS=20

# Should conversation history persist across ESP32 reconnects?
# true  = robot remembers previous sessions
# false = fresh start on every reconnect
MEMORY_PERSIST_ACROSS_SESSIONS=true


# ── Server Settings ──────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000


# ── Debug ────────────────────────────────────────────
LOG_LEVEL=INFO       # DEBUG | INFO | WARNING | ERROR
